# ========================================
# SECURE ENVIRONMENT CONFIGURATION
# ========================================
# This file should NOT be committed to version control
# Use .env.example as a template and set values via your deployment platform

# Blockchain Network URLs - Set via secure environment variables
SEPOLIA_RPC_URL=${SEPOLIA_RPC_URL}
MAINNET_RPC_URL=${MAINNET_RPC_URL}
POLYGON_RPC_URL=${POLYGON_RPC_URL}
MUMBAI_RPC_URL=${MUMBAI_RPC_URL}
ARBITRUM_RPC_URL=${ARBITRUM_RPC_URL}
OPTIMISM_RPC_URL=${OPTIMISM_RPC_URL}
BSC_RPC_URL=${BSC_RPC_URL}

# Deployment Private Key - MUST be set via secure secret management
# CRITICAL: Never commit private keys to version control
PRIVATE_KEY=${DEPLOYMENT_PRIVATE_KEY}

# API Keys for contract verification - Set via secure environment variables
ETHERSCAN_API_KEY=${ETHERSCAN_API_KEY}
POLYGONSCAN_API_KEY=${POLYGONSCAN_API_KEY}
ARBISCAN_API_KEY=${ARBISCAN_API_KEY}
OPTIMISM_API_KEY=${OPTIMISM_API_KEY}
BSCSCAN_API_KEY=${BSCSCAN_API_KEY}

# Contract Addresses - Set via secure environment variables
OUI_IDENTITY_ADDRESS=${OUI_IDENTITY_ADDRESS}
UVT_TOKEN_ADDRESS=${UVT_TOKEN_ADDRESS}
DAO_ADDRESS=${DAO_ADDRESS}
WATERMARK_ADDRESS=${WATERMARK_ADDRESS}
ZKP_VERIFIER_ADDRESS=${ZKP_VERIFIER_ADDRESS}
COMPLIANCE_ADDRESS=${COMPLIANCE_ADDRESS}

# Development Configuration
REPORT_GAS=${REPORT_GAS:-true}
